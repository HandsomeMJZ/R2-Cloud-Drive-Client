{
  "name": "r2-cloud-drive-client",
  "version": "1.1.8",
  "description": "Electron desktop client for the R2 Cloud Drive API.",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main/main.js && node --check src/main/apiClient.js && node --check src/preload/preload.js && node --check src/renderer/mobile-bridge.js && node --check src/renderer/renderer.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --config.directories.output=release-windows",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "set \"JAVA_HOME=C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot\" && set \"ANDROID_HOME=C:\\Users\\Administrator\\AppData\\Local\\Android\\Sdk\" && set \"ANDROID_SDK_ROOT=C:\\Users\\Administrator\\AppData\\Local\\Android\\Sdk\" && set \"PATH=%JAVA_HOME%\\bin;%ANDROID_HOME%\\platform-tools;%PATH%\" && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "io.qzz.r2drive.client",
    "productName": "R2 Cloud Drive",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "shortcutName": "R2 Cloud Drive"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  }
}
